# =============================================================================
# custom.config — SM-X810 KernelSU-Next GKI build
# Aplicado sobre gki_defconfig via build_lkm.sh (cat >> .config + olddefconfig)
# NO modifica gki_defconfig original.
# =============================================================================


# =============================================================================
# SAMSUNG — Protecciones anti-root
# =============================================================================

# Identificador del build personalizado
CONFIG_LOCALVERSION="-kernelsu-gki"

# DEFEX: Samsung's Defex security framework
CONFIG_SECURITY_DEFEX=n

# FIVE: File Integrity Verification Engine
CONFIG_FIVE=n
CONFIG_FIVE_GKI_10=n
CONFIG_FIVE_TEE_DRIVER=n
CONFIG_FIVE_PA_FEATURE=n

# PROCA: Process Authenticator
CONFIG_PROCA=n
CONFIG_PROCA_S_OS=n
CONFIG_PROCA_GKI_10=n

# RKP / UH (Micro Hypervisor)
# En kernels GKI puro pueden no existir; se ignoran silenciosamente si no aplican
CONFIG_UH=n
CONFIG_UH_RKP=n
CONFIG_UH_LKMAUTH=n
CONFIG_UH_LKM_BLOCK=n
CONFIG_RKP_CFP_JOPP=n
CONFIG_RKP_CFP_ROPP=n
CONFIG_RKP_CFP=n


# =============================================================================
# KNOX — Samsung Knox Network Control
# =============================================================================
#
# ADVERTENCIA: NO deshabilitar CONFIG_KNOX_NCM.
# net/netfilter/nf_conntrack_core.c llama check_ncm_flag() y
# check_intermediate_flag() fuera de cualquier #ifdef CONFIG_KNOX_NCM (bug Samsung).
# Con =n esas funciones no existen → link error inevitable en compilación.
# Knox NCM solo monitorea tráfico de red Knox; NO bloquea KernelSU GKI.
#
# CONFIG_KNOX_NCM=n   ← NO USAR


# =============================================================================
# KernelSU-Next — GKI mode
# =============================================================================
#
# Compilado dentro de Image (no como .ko). Los hooks se instalan en kernel_init
# antes de que RKP/EL2 se active completamente. Ver NOTES.md para detalles.
#
# Prerequisitos ya presentes en gki_defconfig (no se repiten):
#   CONFIG_KPROBES=y        (línea 101)
#   CONFIG_MODULES=y        (línea 106)
#   CONFIG_KALLSYMS_ALL=y   (línea 47)

CONFIG_KSU=y


# =============================================================================
# DroidSpaces — Obligatorio (GKI kABI-safe)
# =============================================================================
#
# IMPORTANTE: Aplicar el parche kABI ANTES de compilar con estas configs:
#   patch -p1 < Droidspaces-OSS/Documentation/resources/kernel-patches/
#              GKI/below-kernel-6.12/001.GKI-below-6.12-fix_sysvipc_kabi_6_7_8.patch
#
# Sin el parche, CONFIG_SYSVIPC y CONFIG_IPC_NS desplazan offsets en task_struct
# y rompen los módulos vendor precompilados de Samsung (GPU, cámara, audio) → bootloop.
# Si el parche _6_7_8 causa bootloop, intentar _3_4_5 y luego _1_2_3.
#
# CONFIG_PID_NS: deshabilitado explícitamente en gki_defconfig → override necesario aquí.

# IPC
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# Namespaces
CONFIG_IPC_NS=y
CONFIG_PID_NS=y

# Acceso a hardware desde el contenedor
CONFIG_DEVTMPFS=y


# =============================================================================
# DroidSpaces — Opcional (firewall: UFW / Fail2ban / NAT)
# =============================================================================

# Docker/NAT support
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# Docker/nftables — BOOTLOOP CONFIRMADO en SM-X810, NO habilitar.
#
# CONFIG_BRIDGE_NETFILTER inserta SKB_EXT_BRIDGE_NF en el enum skb_ext_id
# (include/linux/skbuff.h), desplazando todos los índices subsiguientes y
# cambiando SKB_EXT_NUM. Los módulos vendor Samsung compilados contra el GKI
# sin este flag acceden a índices incorrectos → kernel panic en boot.
# NinjaSU lo deshabilitó explícitamente en kalama_gki_defconfig por la misma razón.
#
# CONFIG_NF_TABLES tiene interacción similar con nf_conntrack_core.c de Samsung
# (hooks Knox NCM fuera de #ifdef). Deshabilitado por NinjaSU también.
#
# Workaround para Docker en DroidSpaces (documentado en Cool-things-you-can-do.md):
#   1. Usar NAT mode en el contenedor
#   2. Dentro del contenedor Debian: update-alternatives --set iptables /usr/sbin/iptables-legacy
#                                    update-alternatives --set ip6tables /usr/sbin/ip6tables-legacy
#
# CONFIG_BRIDGE_NETFILTER=y   ← BOOTLOOP — kABI break en skb_ext_id enum
# CONFIG_NF_TABLES=y          ← BOOTLOOP — interacción Knox NCM / nf_conntrack
# CONFIG_NFT_COMPAT=y         ← depende de NF_TABLES, excluido junto


# UFW support
CONFIG_NETFILTER_XT_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y

# Fail2ban support
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y

# NixOS setcap wrappers en /run/wrappers
CONFIG_TMPFS_XATTR=y
