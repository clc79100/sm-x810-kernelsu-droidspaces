# =============================================================================
# custom.config — SM-X810 KernelSU-Next GKI build
# Aplicado sobre gki_defconfig via build_lkm.sh (cat >> .config + olddefconfig)
# NO modifica gki_defconfig original.
#
# IMPORTANTE: Este archivo solo deshabilita protecciones anti-root.
# Las configs de DroidSpaces NO están aquí porque requieren primero aplicar
# el parche kABI: Droidspaces-OSS/Documentation/resources/kernel-patches/
#                 GKI/below-kernel-6.12/001.GKI-below-6.12-fix_sysvipc_kabi_6_7_8.patch
# =============================================================================

# --- Identificador del build personalizado ---
CONFIG_LOCALVERSION="-kernelsu-gki"

# --- Deshabilitar protecciones anti-root Samsung (encontradas en gki_defconfig) ---
# DEFEX: Samsung's Defex security framework
CONFIG_SECURITY_DEFEX=n

# FIVE: File Integrity Verification Engine
CONFIG_FIVE=n
CONFIG_FIVE_GKI_10=n
CONFIG_FIVE_TEE_DRIVER=n
CONFIG_FIVE_PA_FEATURE=n

# PROCA: Process Authenticator
CONFIG_PROCA=n
CONFIG_PROCA_S_OS=n
CONFIG_PROCA_GKI_10=n

# Knox: Samsung Knox Network Control Manager
# NOTA: NO deshabilitar CONFIG_KNOX_NCM — el código en
# net/netfilter/nf_conntrack_core.c línea 1615 llama check_ncm_flag() y
# check_intermediate_flag() SIN #ifdef CONFIG_KNOX_NCM (bug Samsung).
# Con =n esas funciones no existen → link error inevitable.
# Knox NCM solo monitorea conexiones de red Knox; NO bloquea KernelSU GKI.
# CONFIG_KNOX_NCM queda en =y (valor del gki_defconfig original).
# CONFIG_KNOX_NCM=n   ← NO USAR

# RKP / UH (Micro Hypervisor) — incluidas por si existen en tu build
# En kernels GKI puro pueden no existir, se ignoran si no aplican
CONFIG_UH=n
CONFIG_UH_RKP=n
CONFIG_UH_LKMAUTH=n
CONFIG_UH_LKM_BLOCK=n
CONFIG_RKP_CFP_JOPP=n
CONFIG_RKP_CFP_ROPP=n
CONFIG_RKP_CFP=n

# --- Requerido para KernelSU-Next GKI (ya presente en gki_defconfig, verificado) ---
# CONFIG_KPROBES=y        <- ya en gki_defconfig línea 101
# CONFIG_MODULES=y        <- ya en gki_defconfig línea 106
# CONFIG_KALLSYMS_ALL=y   <- ya en gki_defconfig línea 47
# (se listan solo como referencia, no se repiten aquí)

# --- KernelSU-Next GKI mode ---
CONFIG_KSU=y

# =============================================================================
